{
  "name": "integration-service",
  "version": "1.0.0",
  "description": "Production-ready Integration Service with Node.js/Express",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate:up": "node dist/infrastructure/database/migrator.js up",
    "migrate:down": "node dist/infrastructure/database/migrator.js down",
    "migrate:create": "node dist/infrastructure/database/migrator.js create"
  },
  "keywords": [
    "integration",
    "api",
    "express",
    "rest",
    "soap",
    "kafka",
    "rabbitmq",
    "redis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "prom-client": "^15.1.0",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "amqplib": "^0.10.3",
    "axios": "^1.6.2",
    "soap": "^1.0.0",
    "xml2js": "^0.6.2",
    "pg": "^8.11.3",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1",
    "http-status-codes": "^2.3.0",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/amqplib": "^0.10.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/jest": "^29.5.10",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
