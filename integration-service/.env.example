# Application Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
SERVICE_NAME=integration-service

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integration_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=integration-service
KAFKA_GROUP_ID=integration-service-group
KAFKA_TOPIC_REQUESTS=integration.requests
KAFKA_TOPIC_RESPONSES=integration.responses
KAFKA_TOPIC_EVENTS=integration.events

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=integration.exchange
RABBITMQ_QUEUE=integration.queue
RABBITMQ_ROUTING_KEY=integration.route

# External API Configuration
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_DELAY=1000

# SOAP Configuration
SOAP_ENDPOINT_URL=http://localhost:8080/soap/service
SOAP_WSDL_URL=http://localhost:8080/soap/service?wsdl

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=1h
API_KEY=your-api-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Cache
CACHE_TTL=300
CACHE_MAX_SIZE=1000
