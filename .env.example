# app_config.py

import os

class Config:
    # Application configurations
    DEBUG = os.getenv('FLASK_DEBUG', False)
    # DEBUG: Now uses environment variable FLASK_DEBUG with a default of False

    TESTING = os.getenv('FLASK_TESTING', False)
    # TESTING: Now uses environment variable FLASK_TESTING with a default of False

    SECRET_KEY = os.getenv('FLASK_SECRET_KEY', 'default-secret-key')
    # SECRET_KEY: Now uses environment variable FLASK_SECRET_KEY with default value for local usage

    # Database configurations
    SQLALCHEMY_DATABASE_URI = os.getenv('DATABASE_URL', 'sqlite:///default.db')
    # SQLALCHEMY_DATABASE_URI: Now uses environment variable DATABASE_URL with default SQLite for development

    SQLALCHEMY_TRACK_MODIFICATIONS = os.getenv('SQLALCHEMY_TRACK_MODIFICATIONS', False)
    # SQLALCHEMY_TRACK_MODIFICATIONS: Added environment variable to control modification tracking, defaults to False

    # Additional Flask configurations can be added here.
    # Add your custom or additional configuration parameters here using os.getenv for flexibility

# Commented deprecated hardcoded configurations
# DEBUG = False
# SECRET_KEY = 'hardcoded-secret'
# SQLALCHEMY_DATABASE_URI = 'sqlite:///hardcoded.db'
```

Note: Load all sensitive information and environment-specific configurations from environment variables to remove hardcoded values and boost security and flexibility.