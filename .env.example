[app]
# Application Configuration File
debug = False
allowed_hosts = ['*']

[flask]
# Flask Configuration
# Changed from Flask 1.x to 3.x to support async
async_mode = True  # Enables asynchronous request handling

[database]
# SQLAlchemy Database Configuration
db_uri = "postgresql://user:password@localhost/dbname"

# Upgrade SQLAlchemy from 1.3 to 2.x
# SQLALCHEMY_TRACK_MODIFICATIONS is deprecated in SQLAlchemy 2.x
# to reduce unnecessary overhead and is removed
# sqlalchemy_track_modifications = False  

[async]
# Asynchronous operations settings
# Enhance performance by utilizing Python's asyncio library for endpoints
enable_async = True  # Enables async capability across application endpoints

[deployment]
# Deployment settings
# Switching to WSGI-based deployment for better async support
deployment_method = "wsgi"  # Use WSGI deployment to deal with multiprocess scenarios