# ─────────────────────────────────────────────────────────────────────────────
# ProjectManagementService — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/projectmanagement
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── JPA / Hibernate ───────────────────────────────────────────────────────────
# Options: validate | update | create | create-drop
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── External Services ─────────────────────────────────────────────────────────
CALENDAR_SERVICE_URL=http://localhost:8081
REPORTING_SERVICE_URL=http://localhost:8082

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SPRING_WEB_LOG_LEVEL=WARN
