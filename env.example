# ============================================================================
# Claude Code Wrapper Service - Environment Variables
# ============================================================================
# Complete configuration template for EC2 instance deployment
#
# Quick Start:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your Claude API key and AWS configuration
# 3. Start the service: python main.py
# ============================================================================

# ----------------------------------------------------------------------------
# Claude Agent SDK Configuration
# ----------------------------------------------------------------------------
# Required: Anthropic API key for Claude Agent SDK
# Get from: https://console.anthropic.com/
# Note: ANTHROPIC_API_KEY is the standard name (preferred)
# CLAUDE_API_KEY is also supported as an alias
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_API_KEY=your_anthropic_api_key_here  # Alternative name (optional)

# ----------------------------------------------------------------------------
# Service Configuration
# ----------------------------------------------------------------------------
# Service host (default: 0.0.0.0 to accept connections from all interfaces)
EC2_SERVICE_HOST=0.0.0.0

# Service port (default: 8080)
EC2_SERVICE_PORT=8080

# Number of worker processes (default: 1)
EC2_SERVICE_WORKERS=1

# ----------------------------------------------------------------------------
# File Management
# ----------------------------------------------------------------------------
# Temporary directory for project files (default: /tmp/claude-scaffold)
EC2_TEMP_DIR=/tmp/claude-scaffold

# Maximum file upload size in bytes (default: 100MB)
# Format: number (e.g., 104857600 for 100MB)
MAX_FILE_SIZE=104857600

# Cleanup interval in seconds (default: 3600 = 1 hour)
# Old files and sessions will be cleaned up periodically
CLEANUP_INTERVAL=3600

# Maximum number of concurrent sessions (default: 100)
MAX_SESSIONS=100

# Session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT=3600

# ----------------------------------------------------------------------------
# AWS Configuration
# ----------------------------------------------------------------------------
# AWS region for S3 operations (default: us-east-1)
AWS_REGION=us-east-1

# AWS Credentials (local dev only - use IAM roles in EC2)
# In production, use IAM instance profile instead
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=  # Optional, for temporary credentials

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Git Configuration
# ----------------------------------------------------------------------------
# GitHub token for private repository access (optional)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Git clone timeout in seconds (default: 600 = 10 minutes)
CLONE_TIMEOUT=600

# Maximum repository size in GB (default: 5GB)
MAX_REPO_SIZE_GB=5

# ----------------------------------------------------------------------------
# Disk Space Configuration
# ----------------------------------------------------------------------------
# Minimum free disk space required in GB (default: 2GB)
MIN_FREE_SPACE_GB=2

# ----------------------------------------------------------------------------
# Cloud Storage Provider Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of cloud storage providers to enable
# Options: "s3", "gcs", "azure", or "all"
# Default: "s3" (only S3 enabled)
# Examples:
#   CLOUD_STORAGE_PROVIDERS=s3                    # Only S3 (default)
#   CLOUD_STORAGE_PROVIDERS=s3,gcs                # S3 and GCS
#   CLOUD_STORAGE_PROVIDERS=gcs                   # Only GCS
#   CLOUD_STORAGE_PROVIDERS=all                   # All providers
#
# Note: Only enabled providers will be available. This allows you to avoid
# installing unnecessary dependencies. Install optional dependencies with:
#   pip install google-cloud-storage          # For GCS
#   pip install azure-storage-blob           # For Azure
#   pip install -e ".[all-cloud-storage]"     # For all providers
CLOUD_STORAGE_PROVIDERS=s3

# ----------------------------------------------------------------------------
# Optional: S3 Bucket Configuration
# ----------------------------------------------------------------------------
# Default S3 bucket for project file storage
# If not set, will auto-resolve from buckets starting with "ace-claude-code-"
# DEFAULT_S3_BUCKET=ace-claude-code-projects

# ----------------------------------------------------------------------------
# Optional: GCS Configuration (if GCS provider enabled)
# ----------------------------------------------------------------------------
# GCP Project ID (optional, uses default credentials if not provided)
# GCP_PROJECT_ID=your-gcp-project-id

# ----------------------------------------------------------------------------
# Optional: Azure Blob Storage Configuration (if Azure provider enabled)
# ----------------------------------------------------------------------------
# Azure Storage connection string (preferred method)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# OR use account name and key separately:
# AZURE_STORAGE_ACCOUNT_NAME=your-account-name
# AZURE_STORAGE_ACCOUNT_KEY=your-account-key

