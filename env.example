# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_NAME=event-processing-service
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=event-processing-service
KAFKA_TOPICS=["project-events"]
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLED=true

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=project_events
RABBITMQ_QUEUE=event-processing-service
RABBITMQ_ROUTING_KEY=#
RABBITMQ_ENABLED=false

# ── Notifications (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SENDER_ADDRESS=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Action Dispatcher ─────────────────────────────────────────────────────────
ACTION_DISPATCHER_BASE_URL=http://localhost:8080
ACTION_DISPATCHER_TIMEOUT=10
