# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/project_creation_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── JPA ───────────────────────────────────────────────────────────────────────
# Options: validate | update | create | create-drop
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
