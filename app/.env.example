# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# JWT Configuration
# ──────────────────────────────────────────────
# REQUIRED: Change these secrets before deploying to production!
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
# Levels: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
